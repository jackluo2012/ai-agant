# llama.cpp 服务器配置
LLAMA_HOST=192.168.1.158
LLAMA_PORT=11434

# 模型配置
MODEL_NAME=MiniCPM5-1B-Q4_K_M.gguf

# 生成配置
MAX_NEW_TOKENS=100
TEMPERATURE=0.7
TOP_P=0.9

# 可视化配置
VIZ_OUTPUT_DIR=visualizations
VIZ_COLORMAP=viridis
VIZ_FIGSIZE=14,10
VIZ_DPI=150

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=attention_viz.log

# 结果输出目录
RESULTS_DIR=results
