# ===== API 配置 =====
# 通用 API 密钥（所有提供商都支持）
API_KEY=your-api-key-here

# 或者使用特定提供商的 API 密钥（会覆盖上面的 API_KEY）
# KIMI_API_KEY=your-kimi-api-key-here
# MOONSHOT_API_KEY=your-moonshot-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# LLM 提供商（可选，预设: kimi, moonshot, openai, deepseek, anthropic, custom）
# 如果不指定，默认使用 "kimi"
LLM_PROVIDER=kimi

# 模型名称（可选，不指定则使用提供商默认模型）
LLM_MODEL=kimi-k3

# API 基础 URL（可选，用于自定义提供商）
# 如果使用 custom 提供商，必须指定此参数
BASE_URL=

# ===== 功能开关 =====
# 启用时间戳跟踪
ENABLE_TIMESTAMPS=true

# 启用工具调用计数器
ENABLE_TOOL_COUNTER=true

# 启用 TODO 列表管理
ENABLE_TODO_LIST=true

# 启用详细错误信息
ENABLE_DETAILED_ERRORS=true

# 启用系统状态感知
ENABLE_SYSTEM_STATE=true

# ===== 格式化选项 =====
# 时间戳格式
TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S

# 模拟时间延迟（演示用）
SIMULATE_TIME_DELAY=false

# ===== 执行选项 =====
# 最大迭代次数
MAX_ITERATIONS=20

# 详细日志输出
VERBOSE=false

# 命令执行超时（秒）
COMMAND_TIMEOUT=30
