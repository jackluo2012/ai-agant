# Agent Creator 项目配置示例
#
# 注意：LLM 配置（API_KEY, LLM_PROVIDER, LLM_MODEL, BASE_URL）现在使用项目根目录的统一 .env 文件。
# 此文件仅包含本实验特定的配置选项。

# 请求超时（秒）
AGENT_CREATOR_REQUEST_TIMEOUT=600

# 提供商选择（测试用，通常使用 auto 从项目根目录 .env 继承）
# AGENT_CREATOR_PROVIDER=auto
# AGENT_CREATOR_MODEL=

# 兼容性：支持以下环境变量（优先使用项目根目录 .env）
# MOONSHOT_API_KEY, KIMI_API_KEY, KIMI_MODEL
# ARK_API_KEY, ARK_MODEL
# OPENAI_API_KEY, OPENAI_MODEL
# OPENROUTER_API_KEY, OPENROUTER_MODEL
