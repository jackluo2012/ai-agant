# ============================================================
# 本实验的环境变量示例
#
# 文本 LLM（自主决策 + 字段值抽取）的配置统一放在项目根目录
# ai-agant/.env 中（API_KEY / LLM_PROVIDER / LLM_MODEL / BASE_URL），
# 本目录不再单独配置文本模型。
# ============================================================

# ---- 音频专用模型（TTS/ASR 是音频接口，与文本模型相互独立）----
OPENAI_ASR_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# ---- 本机麦克风调优（仅在裁音或句末等待过久时调整）----
VOICE_SAMPLE_RATE=16000
VOICE_SILENCE_SECONDS=0.9
VOICE_RMS_THRESHOLD=0.012
AUDIO_PLAYER=afplay

# ---- WebRTC 语音后端 ----
# auto：优先本机 say/espeak TTS + Gemini ASR（若可用），否则使用统一客户端音频接口。
# 显式取值：openai、gemini-system、local-whisper。
# local-whisper 需安装 openai-whisper 或用 WHISPER_PYTHON 指向已有环境；
# 音频与转录文本都是临时的，用后即弃。
WEBRTC_SPEECH_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-2.5-flash
WHISPER_PYTHON=
WHISPER_MODEL=tiny

# ---- 可选旧 Twilio PSTN 传输层（WebRTC 路径完全不需要以下变量）----
# TWILIO_WEBHOOK_BASE_URL 必须通过 HTTPS 隧道/反向代理指向 TWILIO_LOCAL_PORT。
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PHONE_USER_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_LOCAL_PORT=8765
TWILIO_LANGUAGE=zh-CN
TWILIO_VOICE=Google.zh-CN-Standard-A
