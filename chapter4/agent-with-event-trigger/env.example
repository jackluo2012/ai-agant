# 事件驱动 Agent 项目配置
#
# 注意：LLM 配置（API 密钥、提供商、模型）现在从项目根目录的 .env 文件读取
# 请在 ai-agant/.env 中配置以下变量：
#   - API_KEY=your-api-key
#   - LLM_PROVIDER=kimi (或 siliconflow, doubao, deepseek, aliyun 等)
#   - LLM_MODEL=kimi-k3 (可选)
#   - BASE_URL=https://... (如需要)

# ============================================================================
# 项目特定配置
# ============================================================================

# MCP 工具配置（可选）
# ENABLE_MCP_TOOLS=true  # 是否启用 MCP 工具（默认：true）

# 服务器配置（可选）
# AGENT_HOST=0.0.0.0      # 服务器监听地址（默认：0.0.0.0）
# AGENT_PORT=8000         # 服务器监听端口（默认：8000）

# Agent 行为配置（可选）
# MAX_ITERATIONS=20       # 单个事件的最大工具调用轮数（默认：20）
# COMMAND_TIMEOUT=30      # 命令执行超时（秒）（默认：30）

# 日志配置（可选）
# VERBOSE=false          # 是否输出详细日志（默认：false）
# LOG_LEVEL=INFO         # 日志级别（DEBUG, INFO, WARNING, ERROR）
